{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plateau",
  "version": "1.0.0",
  "identifier": "com.plateau.dashboard",
  "build": {
    "frontendDist": "loading",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plateau",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "binaries/launcher",
      "binaries/dashboard",
      "binaries/cb"
    ]
  }
}
