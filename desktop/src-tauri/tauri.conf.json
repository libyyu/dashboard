{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plateau",
  "version": "1.0.0",
  "identifier": "com.plateau.dashboard",
  "build": {
    "frontendDist": "loading",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plateau",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "libyyu",
    "copyright": "Copyright © 2026 libyyu",
    "category": "DeveloperTool",
    "shortDescription": "Plateau Dashboard",
    "longDescription": "Plateau Dashboard 桌面工作台：本地 FastAPI 服务 + Vue 3 控制台。",
    "icon": ["icons/icon.ico"],
    "resources": [
      "binaries/launcher",
      "binaries/dashboard",
      "binaries/cb"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Plateau"
      }
    }
  }
}
